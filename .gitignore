# PySpark Comprehensive Tutorial - .gitignore

# =============================================================================
# PYTHON & JUPYTER
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
pyspark_env/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# =============================================================================
# SPARK & BIG DATA
# =============================================================================

# Spark logs and metadata
spark-warehouse/
metastore_db/
derby.log
*.log

# Spark checkpoints and temporary files
checkpoints/
streaming/checkpoints/
/tmp/
temp/
temporary/

# Parquet files (large data files)
*.parquet
*.snappy.parquet
*.gz.parquet

# Delta Lake
_delta_log/
*.delta

# =============================================================================
# DATA & OUTPUTS
# =============================================================================

# Large data files
*.csv.gz
*.json.gz
*.avro
*.orc

# Model artifacts
models/
saved_models/
model_checkpoints/

# Output directories
outputs/
results/
reports/
exports/

# Streaming data
streaming/data/
streaming/raw/
streaming/processed/

# =============================================================================
# DEVELOPMENT & IDE
# =============================================================================

# PyCharm
.idea/
*.iws
*.iml
*.ipr

# VSCode
.vscode/
*.code-workspace

# =============================================================================
# SYSTEM & OS
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
*.tmp
Desktop.ini

# Linux
*~
.directory

# =============================================================================
# CREDENTIALS & SECRETS
# =============================================================================

# Environment variables and secrets
.env.local
.env.production
secrets.json
credentials.json

# =============================================================================
# PROJECT SPECIFIC
# =============================================================================

# Large datasets (keep sample data only)
/data/large/
*.zip
*.tar.gz

# Performance logs
performance_*.log
